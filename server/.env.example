# Port Server Express
PORT=5050
CORS_ORIGIN=http://localhost:5173

# Supabase (Gunakan Project URL & Secret / Service Role Key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

# Google AI Studio Gemini API (Hanya di server, jangan pernah taruh di frontend)
# Dapatkan kunci di: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
